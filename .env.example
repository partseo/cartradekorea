# ==============================================================================
# GLOBAL USED CAR EXPORT PLATFORM - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# 이 파일은 개발 및 배포 환경에 필요한 모든 환경 변수 템플릿입니다.
# 실제 배포 시에는 Vercel 환경 변수 설정에 등록하고, 로컬 개발 시에는 .env.local 파일을 만들어 사용하십시오.
# 
# [환경변수 보안 및 노출 구분표]
# ------------------------------------------------------------------------------
# 변수명                              | 사용 위치     | 브라우저 노출 | 비고
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL           | Client/Server | 가능          | Supabase API 엔드포인트 URL
# NEXT_PUBLIC_SUPABASE_ANON_KEY      | Client/Server | 가능          | 클라이언트 조회용 RLS 보안 키
# SUPABASE_SERVICE_ROLE_KEY          | Server only   | 불가          | DB 전권 관리자 키 (절대 NEXT_PUBLIC_ 금지)
# NEXT_PUBLIC_SITE_URL               | Client/Server | 가능          | 호스팅 도메인 (sitemap/robots용)
# RESEND_API_KEY                     | Server only   | 불가          | 견적 알림 메일 발송용 API Key
# NEXT_PUBLIC_WHATSAPP_PHONE_NUMBER  | Client        | 가능          | 메인 바이어 상담용 WhatsApp 번호
# WHATSAPP_API_TOKEN                 | Server only   | 불가          | WhatsApp 클라우드 연동 전송 토큰 (선택)
# ==============================================================================

# 1. Supabase 설정 (Local / Staging / Production 환경별로 구분하여 등록)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. 호스팅 사이트 URL (Local: http://localhost:3000 | Prod: https://www.cartradekorea.com)
NEXT_PUBLIC_SITE_URL=https://www.cartradekorea.com

# 3. 이메일 알림 연동 (Resend API Key)
RESEND_API_KEY=re_your_resend_api_key

# 4. 바이어 실시간 채팅 (국가코드 포함 숫자만 기입, e.g. 821012345678)
NEXT_PUBLIC_WHATSAPP_PHONE_NUMBER=821000000000
WHATSAPP_API_TOKEN=your-whatsapp-api-token
